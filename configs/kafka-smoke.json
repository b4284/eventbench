{
  "Name": "kafka-smoke",
  "Workload": {
    "DurationSeconds": 10,
    "WarmupSeconds": 2,
    "DrainTimeoutSeconds": 60,
    "Groups": [
      { "Name": "hot",  "Count": 2, "Sources": 200, "RatePerGroup": 1000 },
      { "Name": "cold", "Count": 2, "Sources": 200, "RatePerGroup": 250 }
    ],
    "LargePayload": { "Probability": 0.001, "MaxCount": 3, "MinBytes": 1048576, "MaxBytes": 16777216, "Mode": "Inline" }
  },
  "Worker": { "WorkersPerGroup": 4, "BatchSize": 10 },
  "Metrics": { "ContainerStats": false },
  "Broker": { "Type": "kafka", "BootstrapServers": "127.0.0.1:9092" },
  "Store":  { "Type": "inmemory" }
}
