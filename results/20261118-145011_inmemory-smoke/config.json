{
  "Broker": {
    "Type": "inmemory"
  },
  "Metrics": {
    "ConsoleProgress": "false",
    "ContainerStats": "False"
  },
  "Name": "inmemory-smoke",
  "Store": {
    "Type": "inmemory"
  },
  "Worker": {
    "BatchSize": "10",
    "WorkersPerGroup": "4"
  },
  "Workload": {
    "DrainTimeoutSeconds": "30",
    "DurationSeconds": "8",
    "Groups": {
      "0": {
        "Count": "2",
        "Name": "hot",
        "RatePerGroup": "2000",
        "Sources": "200"
      },
      "1": {
        "Count": "2",
        "Name": "cold",
        "RatePerGroup": "500",
        "Sources": "200"
      }
    },
    "LargePayload": {
      "MaxBytes": "4194304",
      "MaxCount": "20",
      "MinBytes": "1048576",
      "Probability": "0.01"
    },
    "WarmupSeconds": "2"
  }
}