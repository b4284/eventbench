<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>eventbench</AssemblyName>
    <RootNamespace>EventBench.Cli</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Microsoft.Data.SqlClient refuses to run in invariant globalization mode. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventBench.Core\EventBench.Core.csproj" />
    <ProjectReference Include="..\EventBench.Mongo\EventBench.Mongo.csproj" />
    <ProjectReference Include="..\EventBench.Kafka\EventBench.Kafka.csproj" />
    <ProjectReference Include="..\EventBench.Postgres\EventBench.Postgres.csproj" />
    <ProjectReference Include="..\EventBench.RabbitMq\EventBench.RabbitMq.csproj" />
    <ProjectReference Include="..\EventBench.Nats\EventBench.Nats.csproj" />
    <ProjectReference Include="..\EventBench.SqlServer\EventBench.SqlServer.csproj" />
    <ProjectReference Include="..\EventBench.Redis\EventBench.Redis.csproj" />
    <ProjectReference Include="..\EventBench.MassTransit\EventBench.MassTransit.csproj" />
    <ProjectReference Include="..\EventBench.Temporal\EventBench.Temporal.csproj" />
    <ProjectReference Include="..\EventBench.Octopus\EventBench.Octopus.csproj" />
  </ItemGroup>

</Project>
